generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  RESPONSABLE
  COMPTABLE
  PME
  ADMIN
}

enum Regime {
  REEL
  IGS
}

enum StatutPiece {
  EN_ATTENTE
  RECUE
  A_COMPLETER
  TRAITEE
}

model Cabinet {
  id           String        @id @default(cuid())
  nom          String
  niu          String?
  creeLe       DateTime      @default(now())
  utilisateurs Utilisateur[]
  dossiers     Dossier[]
}

model Utilisateur {
  id              String   @id @default(cuid())
  nom             String
  email           String?  @unique
  telephone       String?  @unique
  motDePasseHache String
  role            Role
  cabinet         Cabinet  @relation(fields: [cabinetId], references: [id])
  cabinetId       String
  dossier         Dossier? @relation(fields: [dossierId], references: [id])
  dossierId       String?
  creeLe          DateTime @default(now())
}

model Dossier {
  id            String        @id @default(cuid())
  raisonSociale String
  niu           String?
  rccm          String?
  regime        Regime
  tauxTva       Decimal       @default(19.25) @db.Decimal(5, 2)
  cabinet       Cabinet       @relation(fields: [cabinetId], references: [id])
  cabinetId     String
  pieces        Piece[]
  utilisateurs  Utilisateur[]
  creeLe        DateTime      @default(now())
}

model Piece {
  id          String      @id @default(cuid())
  dossier     Dossier     @relation(fields: [dossierId], references: [id])
  dossierId   String
  date        DateTime
  montantTtc  Int
  fournisseur String?
  categorie   String
  statut      StatutPiece @default(RECUE)
  fichier     String?
  empreinte   String?
  creeLe      DateTime    @default(now())

  @@index([dossierId, date])
}