generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  RESPONSABLE
  COMPTABLE
  PME
  ADMIN
}

enum Regime {
  REEL
  IGS
}

enum StatutPiece {
  EN_ATTENTE
  RECUE
  A_COMPLETER
  TRAITEE
  REMPLACEE
}

enum StatutDemande {
  OUVERTE
  SATISFAITE
  ANNULEE
}

enum StatutInvitation {
  EN_ATTENTE
  ACCEPTEE
  ANNULEE
}

enum StatutRattachement {
  EN_ATTENTE
  ACCEPTEE
  REFUSEE
  ANNULEE
}

enum TypeFacture {
  FACTURE
  AVOIR
}

enum StatutFacture {
  BROUILLON
  EMISE
  ANNULEE
}

model Cabinet {
  id            String                @id @default(cuid())
  nom           String
  niu           String?
  autonome      Boolean               @default(false)
  partenaire    Boolean               @default(false)
  ville         String?
  rattachements DemandeRattachement[]
  creeLe        DateTime              @default(now())
  utilisateurs  Utilisateur[]
  dossiers      Dossier[]
  invitations   Invitation[]
}

model Utilisateur {
  id                    String                 @id @default(cuid())
  nom                   String
  email                 String?                @unique
  telephone             String?                @unique
  motDePasseHache       String
  versionJeton    Int            @default(0)
  role                  Role
  cabinet               Cabinet                @relation(fields: [cabinetId], references: [id])
  cabinetId             String
  dossier               Dossier?               @relation(fields: [dossierId], references: [id])
  dossierId             String?
  piecesValidees        Piece[]                @relation("PiecesValidees")
  demandesCreees        DemandePiece[]
  lotsExport            LotExport[]
  invitationsCreees     Invitation[]
  rattachementsCrees    DemandeRattachement[]  @relation("RattachementsCrees")
  rattachementsTraites  DemandeRattachement[]  @relation("RattachementsTraites")
  codesReinitialisation CodeReinitialisation[]
  creeLe                DateTime               @default(now())
}

model Dossier {
  id                String                @id @default(cuid())
  raisonSociale     String
  niu               String?
  rccm              String?
  regime            Regime
  tauxTva           Decimal               @default(19.25) @db.Decimal(5, 2)
  cabinet           Cabinet               @relation(fields: [cabinetId], references: [id])
  cabinetId         String
  pieces            Piece[]
  demandes          DemandePiece[]
  lotsExport        LotExport[]
  invitations       Invitation[]
  rattachements     DemandeRattachement[]
  profilFacturation ProfilFacturation?
  clientsFacture    ClientFacture[]
  factures          Facture[]
  compteursFacture  CompteurFacture[]
  memoiresCompte    MemoireCompte[]
  ecritures         EcritureComptable[]
  comptesPerso      CompteDossier[]
  articles          Article[]
  sessionsCaisse    SessionCaisse[]
  achats            Achat[]
  devis             Devis[]
  utilisateurs      Utilisateur[]
  creeLe            DateTime              @default(now())
}

model Piece {
  id                 String          @id @default(cuid())
  dossier            Dossier         @relation(fields: [dossierId], references: [id])
  dossierId          String
  date               DateTime
  montantTtc         Int
  fournisseur        String?
  categorie          String
  statut             StatutPiece     @default(RECUE)
  fichier            String?
  empreinte          String?
  journal            String?
  valideLe           DateTime?
  validePar          Utilisateur?    @relation("PiecesValidees", fields: [valideParId], references: [id])
  valideParId        String?
  lignes             LigneEcriture[]
  demandesConcernees DemandePiece[]  @relation("PieceConcernee")
  demandeSatisfaite  DemandePiece?   @relation("PieceReponse")
  lotExport          LotExport?      @relation(fields: [lotExportId], references: [id], onDelete: SetNull)
  lotExportId        String?
  facture            Facture?        @relation(fields: [factureId], references: [id], onDelete: SetNull)
  factureId          String?         @unique
  creeLe             DateTime        @default(now())

  @@index([dossierId, date])
}

model LigneEcriture {
  id      String  @id @default(cuid())
  piece   Piece   @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  pieceId String
  ordre   Int
  compte  String
  libelle String
  tiers   String?
  debit   Int     @default(0)
  credit  Int     @default(0)

  @@index([pieceId])
}

model DemandePiece {
  id           String        @id @default(cuid())
  dossier      Dossier       @relation(fields: [dossierId], references: [id])
  dossierId    String
  description  String
  echeance     DateTime
  statut       StatutDemande @default(OUVERTE)
  piece        Piece?        @relation("PieceConcernee", fields: [pieceId], references: [id])
  pieceId      String?
  reponse      Piece?        @relation("PieceReponse", fields: [reponseId], references: [id])
  reponseId    String?       @unique
  demandePar   Utilisateur   @relation(fields: [demandeParId], references: [id])
  demandeParId String
  creeLe       DateTime      @default(now())
  satisfaiteLe DateTime?

  @@index([dossierId, statut])
}

model LotExport {
  id          String      @id @default(cuid())
  dossier     Dossier     @relation(fields: [dossierId], references: [id])
  dossierId   String
  creePar     Utilisateur @relation(fields: [creeParId], references: [id])
  creeParId   String
  nbPieces    Int
  nbLignes    Int
  totalDebit  Int
  totalCredit Int
  pieces      Piece[]
  creeLe      DateTime    @default(now())

  @@index([dossierId, creeLe])
}

model Invitation {
  id         String           @id @default(cuid())
  cabinet    Cabinet          @relation(fields: [cabinetId], references: [id])
  cabinetId  String
  dossier    Dossier?         @relation(fields: [dossierId], references: [id])
  dossierId  String?
  role       Role
  nom        String
  telephone  String?
  email      String?
  jetonHache String           @unique
  expireLe   DateTime
  statut     StatutInvitation @default(EN_ATTENTE)
  creePar    Utilisateur      @relation(fields: [creeParId], references: [id])
  creeParId  String
  creeLe     DateTime         @default(now())
  accepteeLe DateTime?

  @@index([cabinetId, statut])
  @@index([dossierId, statut])
}

model DemandeRattachement {
  id          String             @id @default(cuid())
  dossier     Dossier            @relation(fields: [dossierId], references: [id])
  dossierId   String
  cabinet     Cabinet            @relation(fields: [cabinetId], references: [id])
  cabinetId   String
  message     String?
  statut      StatutRattachement @default(EN_ATTENTE)
  creePar     Utilisateur        @relation("RattachementsCrees", fields: [creeParId], references: [id])
  creeParId   String
  traitePar   Utilisateur?       @relation("RattachementsTraites", fields: [traiteParId], references: [id])
  traiteParId String?
  creeLe      DateTime           @default(now())
  traiteeLe   DateTime?

  @@index([cabinetId, statut])
  @@index([dossierId, statut])
}

model ProfilFacturation {
  dossier            Dossier  @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  dossierId          String   @id
  formeJuridique     String?
  adresse            String?
  telephone          String?
  email              String?
  centreImpots       String?
  banque             String?
  compte             String?
  conditionsPaiement String?
  penalitesRetard    String?
  majLe              DateTime @updatedAt
}

model ClientFacture {
  id               String            @id @default(cuid())
  dossier          Dossier           @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  dossierId        String
  nom              String
  adresse          String?
  niu              String?
  telephone        String?
  email            String?
  archive          Boolean           @default(false)
  creeLe           DateTime          @default(now())
  factures         Facture[]
  compteursFacture CompteurFacture[]
  devis            Devis[]

  @@index([dossierId, archive])
}

model Facture {
  id                String             @id @default(cuid())
  dossier           Dossier            @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  dossierId         String
  type              TypeFacture        @default(FACTURE)
  statut            StatutFacture      @default(BROUILLON)
  numero            String?
  client            ClientFacture      @relation(fields: [clientId], references: [id], onDelete: NoAction)
  clientId          String
  dateEmission      DateTime?
  dateEcheance      DateTime?
  regime            Regime
  tauxTva           Decimal            @db.Decimal(5, 2)
  tauxRetenue       Decimal            @default(0) @db.Decimal(5, 2)
  totalHt           Int                @default(0)
  totalTva          Int                @default(0)
  totalTtc          Int                @default(0)
  retenue           Int                @default(0)
  netAPayer         Int                @default(0)
  emetteur          Json?
  clientFige        Json?
  factureOrigine    Facture?           @relation("Avoirs", fields: [factureOrigineId], references: [id])
  factureOrigineId  String?            @unique
  avoir             Facture?           @relation("Avoirs")
  lignes            LigneFacture[]
  creeParId         String
  creeLe            DateTime           @default(now())
  emiseLe           DateTime?
  jetonPartage      String?            @unique
  piece             Piece?
  montantRegle      Int                @default(0)
  derniereRelanceLe DateTime?
  reglements        ReglementFacture[]

  @@unique([dossierId, numero])
  @@index([dossierId, statut])
}

model LigneFacture {
  id           String  @id @default(cuid())
  facture      Facture @relation(fields: [factureId], references: [id], onDelete: Cascade)
  factureId    String
  ordre        Int
  designation  String
  detail       String?
  quantite     Decimal @db.Decimal(12, 3)
  prixUnitaire Int
  totalHt      Int
  // Article du stock facture sur cette ligne (facultatif)
  articleId    String?

  @@index([factureId])
}

model CompteurFacture {
  dossier         Dossier        @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  dossierId       String
  annee           Int
  type            TypeFacture
  dernier         Int
  clientFacture   ClientFacture? @relation(fields: [clientFactureId], references: [id])
  clientFactureId String?

  @@id([dossierId, annee, type])
}

model CodeReinitialisation {
  id            String      @id @default(cuid())
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  utilisateurId String
  codeHache     String
  expireLe      DateTime
  essais        Int         @default(0)
  utiliseLe     DateTime?
  creeLe        DateTime    @default(now())

  @@index([utilisateurId, creeLe])
}

model MemoireCompte {
  id             String   @id @default(cuid())
  dossier        Dossier  @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  dossierId      String
  cleFournisseur String
  compte         String
  journal        String
  utilisations   Int      @default(1)
  majLe          DateTime @updatedAt

  @@unique([dossierId, cleFournisseur])
  @@index([cleFournisseur])
}

enum ModeReglement {
  ESPECES
  VIREMENT
  MTN_MOMO
  ORANGE_MONEY
  CHEQUE
  AUTRE
}

model ReglementFacture {
  id        String        @id @default(cuid())
  facture   Facture       @relation(fields: [factureId], references: [id], onDelete: Cascade)
  factureId String
  date      DateTime
  montant   Int
  mode      ModeReglement
  reference String?
  creeParId String
  creeLe    DateTime      @default(now())

  @@index([factureId])
}

// Trace d'audit : volontairement sans lien avec les autres tables, pour survivre aux suppressions
model JournalAudit {
  id             String   @id @default(cuid())
  cabinetId      String?
  dossierId      String?
  utilisateurId  String
  nomUtilisateur String
  role           Role
  action         String
  cible          String?
  ip             String?
  creeLe         DateTime @default(now())

  @@index([cabinetId, creeLe])
  @@index([dossierId, creeLe])
}

enum OrigineEcriture {
  PIECE
  CAISSE
  STOCK
  MANUELLE
  ACHAT
}

// Grand livre : chaque ecriture equilibree de l'entreprise, quelle que soit son origine
model EcritureComptable {
  id         String               @id @default(cuid())
  dossier    Dossier              @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  dossierId  String
  journal    String
  annee      Int
  numero     Int
  date       DateTime
  libelle    String
  origine    OrigineEcriture
  origineId  String?
  creeParId  String
  creeLe     DateTime             @default(now())
  mouvements MouvementComptable[]

  @@unique([dossierId, journal, annee, numero])
  @@unique([origine, origineId])
  @@index([dossierId, date])
}

model MouvementComptable {
  id         String            @id @default(cuid())
  ecriture   EcritureComptable @relation(fields: [ecritureId], references: [id], onDelete: Cascade)
  ecritureId String
  dossierId  String
  date       DateTime
  ordre      Int
  compte     String
  libelle    String
  tiers      String?
  debit      Int               @default(0)
  credit     Int               @default(0)

  @@index([dossierId, compte, date])
  @@index([ecritureId])
}

// Comptes ajoutes par l'entreprise a son plan comptable
model CompteDossier {
  dossier   Dossier  @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  dossierId String
  numero    String
  intitule  String
  creeLe    DateTime @default(now())

  @@id([dossierId, numero])
}

model CompteurEcriture {
  dossierId String
  journal   String
  annee     Int
  dernier   Int

  @@id([dossierId, journal, annee])
}

enum TypeMouvementStock {
  ENTREE
  SORTIE
  INVENTAIRE
}

// Article vendu ou achete par l'entreprise ; son stock est valorise au cout moyen pondere
model Article {
  id          String           @id @default(cuid())
  dossier     Dossier          @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  dossierId   String
  reference   String
  nom         String
  categorie   String?
  unite       String
  prixVente   Int
  tauxTva     Int
  suiviStock  Boolean          @default(true)
  seuilAlerte Int              @default(0)
  quantite    Int              @default(0)
  valeurStock Int              @default(0)
  coutMoyen   Int              @default(0)
  actif       Boolean          @default(true)
  creeLe      DateTime         @default(now())
  modifieLe   DateTime         @updatedAt
  mouvements  MouvementStock[]

  @@unique([dossierId, reference])
  @@index([dossierId, nom])
}

// Chaque variation de stock : quantite et valeur signees (positives a l'entree)
model MouvementStock {
  id            String             @id @default(cuid())
  article       Article            @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId     String
  dossierId     String
  type          TypeMouvementStock
  date          DateTime
  quantite      Int
  coutUnitaire  Int
  valeur        Int
  quantiteApres Int
  valeurApres   Int
  motif         String
  origine       String?
  origineId     String?
  creeParId     String
  creeLe        DateTime           @default(now())

  @@index([articleId, date])
  @@index([dossierId, date])
}
enum ModeCaisse {
  ESPECES
  MTN_MOMO
  ORANGE_MONEY
}

// Une journee de caisse : du fond de caisse au comptage de fin
model SessionCaisse {
  id              String        @id @default(cuid())
  dossier         Dossier       @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  dossierId       String
  fondInitial     Int
  ouverteLe       DateTime      @default(now())
  ouverteParId    String
  fermeeLe        DateTime?
  fermeeParId     String?
  especesComptees Int?
  ecart           Int?
  ventes          VenteCaisse[]

  @@index([dossierId, fermeeLe])
}

// Un ticket de caisse, numerote par entreprise et par annee
model VenteCaisse {
  id          String             @id @default(cuid())
  dossierId   String
  session     SessionCaisse      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId   String
  annee       Int
  numero      Int
  date        DateTime
  totalHt     Int
  totalTva    Int
  totalTtc    Int
  mode        ModeCaisse
  montantRecu Int?
  monnaie     Int?
  creeParId   String
  creeLe      DateTime           @default(now())
  lignes      LigneVenteCaisse[]

  @@unique([dossierId, annee, numero])
  @@index([sessionId])
}

model LigneVenteCaisse {
  id           String      @id @default(cuid())
  vente        VenteCaisse @relation(fields: [venteId], references: [id], onDelete: Cascade)
  venteId      String
  ordre        Int
  articleId    String
  nom          String
  quantite     Int
  prixUnitaire Int
  tauxTva      Int
  totalHt      Int
  tva          Int
  totalTtc     Int

  @@index([venteId])
  @@index([articleId])
}

model CompteurTicket {
  dossierId String
  annee     Int
  dernier   Int

  @@id([dossierId, annee])
}
enum PaiementAchat {
  A_CREDIT
  ESPECES
  MTN_MOMO
  ORANGE_MONEY
  VIREMENT
}

enum StatutAchat {
  VALIDE
  ANNULE
}

// Un achat de marchandises : il fait entrer le stock et, pour une entreprise autonome, passe au grand livre
model Achat {
  id                   String        @id @default(cuid())
  dossier              Dossier       @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  dossierId            String
  annee                Int
  numero               Int
  date                 DateTime
  fournisseur          String
  referenceFournisseur String?
  avecTva              Boolean
  totalHt              Int
  totalTva             Int
  totalTtc             Int
  paiement             PaiementAchat
  statut               StatutAchat   @default(VALIDE)
  creeParId            String
  creeLe               DateTime      @default(now())
  annuleLe             DateTime?
  lignes               LigneAchat[]

  @@unique([dossierId, annee, numero])
  @@index([dossierId, date])
}

model LigneAchat {
  id           String @id @default(cuid())
  achat        Achat  @relation(fields: [achatId], references: [id], onDelete: Cascade)
  achatId      String
  ordre        Int
  articleId    String
  nom          String
  quantite     Int
  coutUnitaire Int
  totalHt      Int

  @@index([achatId])
}

model CompteurAchat {
  dossierId String
  annee     Int
  dernier   Int

  @@id([dossierId, annee])
}

enum StatutDevis {
  EN_COURS
  ACCEPTE
  REFUSE
  TRANSFORME
}

// Devis envoye a un client ; une fois accepte, il devient un brouillon de facture
model Devis {
  id            String        @id @default(cuid())
  dossier       Dossier       @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  dossierId     String
  numero        String
  annee         Int
  client        ClientFacture @relation(fields: [clientId], references: [id], onDelete: NoAction)
  clientId      String
  dateDevis     DateTime
  validiteJours Int           @default(30)
  note          String?
  statut        StatutDevis   @default(EN_COURS)
  regime        Regime
  tauxTva       Decimal       @db.Decimal(5, 2)
  totalHt       Int
  totalTva      Int
  totalTtc      Int
  factureId     String?       @unique
  creeParId     String
  creeLe        DateTime      @default(now())
  modifieLe     DateTime      @updatedAt
  lignes        LigneDevis[]

  @@unique([dossierId, numero])
  @@index([dossierId, statut])
}

model LigneDevis {
  id           String  @id @default(cuid())
  devis        Devis   @relation(fields: [devisId], references: [id], onDelete: Cascade)
  devisId      String
  ordre        Int
  articleId    String?
  designation  String
  detail       String?
  quantite     Decimal @db.Decimal(12, 3)
  prixUnitaire Int
  totalHt      Int

  @@index([devisId])
}

model CompteurDevis {
  dossierId String
  annee     Int
  dernier   Int

  @@id([dossierId, annee])
}