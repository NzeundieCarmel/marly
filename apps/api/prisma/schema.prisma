generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  RESPONSABLE
  COMPTABLE
  PME
  ADMIN
}

enum Regime {
  REEL
  IGS
}

enum StatutPiece {
  EN_ATTENTE
  RECUE
  A_COMPLETER
  TRAITEE
  REMPLACEE
}

enum StatutDemande {
  OUVERTE
  SATISFAITE
  ANNULEE
}

model Cabinet {
  id           String        @id @default(cuid())
  nom          String
  niu          String?
  creeLe       DateTime      @default(now())
  utilisateurs Utilisateur[]
  dossiers     Dossier[]
}

model Utilisateur {
  id              String         @id @default(cuid())
  nom             String
  email           String?        @unique
  telephone       String?        @unique
  motDePasseHache String
  role            Role
  cabinet         Cabinet        @relation(fields: [cabinetId], references: [id])
  cabinetId       String
  dossier         Dossier?       @relation(fields: [dossierId], references: [id])
  dossierId       String?
  piecesValidees  Piece[]        @relation("PiecesValidees")
  demandesCreees  DemandePiece[]
  creeLe          DateTime       @default(now())
}

model Dossier {
  id            String         @id @default(cuid())
  raisonSociale String
  niu           String?
  rccm          String?
  regime        Regime
  tauxTva       Decimal        @default(19.25) @db.Decimal(5, 2)
  cabinet       Cabinet        @relation(fields: [cabinetId], references: [id])
  cabinetId     String
  pieces        Piece[]
  demandes      DemandePiece[]
  utilisateurs  Utilisateur[]
  creeLe        DateTime       @default(now())
}

model Piece {
  id                 String          @id @default(cuid())
  dossier            Dossier         @relation(fields: [dossierId], references: [id])
  dossierId          String
  date               DateTime
  montantTtc         Int
  fournisseur        String?
  categorie          String
  statut             StatutPiece     @default(RECUE)
  fichier            String?
  empreinte          String?
  journal            String?
  valideLe           DateTime?
  validePar          Utilisateur?    @relation("PiecesValidees", fields: [valideParId], references: [id])
  valideParId        String?
  lignes             LigneEcriture[]
  demandesConcernees DemandePiece[]  @relation("PieceConcernee")
  demandeSatisfaite  DemandePiece?   @relation("PieceReponse")
  creeLe             DateTime        @default(now())

  @@index([dossierId, date])
}

model LigneEcriture {
  id      String  @id @default(cuid())
  piece   Piece   @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  pieceId String
  ordre   Int
  compte  String
  libelle String
  tiers   String?
  debit   Int     @default(0)
  credit  Int     @default(0)

  @@index([pieceId])
}

model DemandePiece {
  id           String        @id @default(cuid())
  dossier      Dossier       @relation(fields: [dossierId], references: [id])
  dossierId    String
  description  String
  echeance     DateTime
  statut       StatutDemande @default(OUVERTE)
  piece        Piece?        @relation("PieceConcernee", fields: [pieceId], references: [id])
  pieceId      String?
  reponse      Piece?        @relation("PieceReponse", fields: [reponseId], references: [id])
  reponseId    String?       @unique
  demandePar   Utilisateur   @relation(fields: [demandeParId], references: [id])
  demandeParId String
  creeLe       DateTime      @default(now())
  satisfaiteLe DateTime?

  @@index([dossierId, statut])
}